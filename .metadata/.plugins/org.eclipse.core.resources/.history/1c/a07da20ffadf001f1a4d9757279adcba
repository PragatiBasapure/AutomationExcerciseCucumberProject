package com.basic;

import java.util.Arrays;
import java.util.Comparator;
import java.util.Scanner;
import java.util.stream.Collectors;

public class StringReverse {

	public String reverseString(String name)
	{
		String result="";
		int size=name.length()-1;
		for(int i=size;i>=0;i--)
		{
			result=result+name.charAt(i);
		}
		return result;
	}
	
	public String reverseStringWithStream(String name)
	{
		String result="";
		 return result=Arrays.stream(name.split("")).sorted(Comparator.reverseOrder()).collect(Collectors.joining());
	}
	
	public static void main(String[] args) {
		
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter a string");
		String name=sc.nextLine();
		
		StringReverse str=new StringReverse();
		String finalString=str.reverseString(name);
		System.out.println("Reverse String is: "+finalString);
		
		

	}

}
